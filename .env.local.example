# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
# Preferred client key (an `sb_publishable_...` key from Supabase).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Legacy fallback only; remove once all environments use the preferred key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Sender.net transactional email (server-only)
SENDER_API_TOKEN=your_sender_api_token_here
SENDER_FROM_EMAIL=hello@fplcompanion.co.uk
SENDER_FROM_NAME=FPL Companion

# Odds providers (optional). If unset, app falls back to FPL-based projections.
ODDS_API_KEY=your_odds_api_key_here
API_FOOTBALL_KEY=your_api_football_key_here
BETFAIR_APP_KEY=your_betfair_app_key_here

# Optional caching controls (future use)
ODDS_CACHE_TTL_SECONDS=600

# Sanity blog CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=50z71eov
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-24
NEXT_PUBLIC_SITE_URL=https://fplcompanion.co.uk

# Google Analytics (enabled only in production)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# AI-powered news signals (Gemini)
GEMINI_API_KEY=
YOUTUBE_API_KEY=your_youtube_data_api_key_here
# Required for POST /api/signals/scan. Send it in X-Scan-Secret; query-string secrets are rejected.
SCAN_SECRET=replace_with_a_long_random_secret


# Required for Supabase server/admin writes. Use an `sb_secret_...` key or the
# legacy service_role JWT; never put the REST URL here.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Daily FPL feed health-check recipient (server-side Netlify environment variable)
FPL_HEALTH_ALERT_EMAIL=
# Production URL checked by the scheduled FPL health function (Netlify Functions only)
FPL_HEALTH_APP_URL=
