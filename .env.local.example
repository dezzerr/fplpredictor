# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Odds providers (optional). If unset, app falls back to FPL-based projections.
ODDS_API_KEY=your_odds_api_key_here
API_FOOTBALL_KEY=your_api_football_key_here
BETFAIR_APP_KEY=your_betfair_app_key_here

# Optional caching controls (future use)
ODDS_CACHE_TTL_SECONDS=600

# Sanity blog CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=50z71eov
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-24
NEXT_PUBLIC_SITE_URL=https://fplcompanion.co.uk

# Google Analytics (enabled only in production)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# AI-powered news signals (Gemini)
GEMINI_API_KEY=
YOUTUBE_API_KEY=your_youtube_data_api_key_here
SCAN_SECRET=random_secret_for_scan_endpoint


# Required for Supabase server/admin writes
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Required to encrypt stored FPL session cookies
# Use either:
# - a random string with at least 32 characters, or
# - a 64-character hex key
FPL_SESSION_ENCRYPTION_KEY=your_32_plus_character_random_secret_here